# Port HTTP server
PORT=3000

# Kosongkan MONGODB_URI untuk menjalankan mode demo (data disimpan di memori dan hilang saat restart)
MONGODB_URI=mongodb://localhost:27017/chat-app

# WAJIB diganti di production: string acak yang panjang, contoh: `openssl rand -hex 32`
JWT_SECRET=ganti_dengan_secret_yang_panjang_dan_acak

# Masa berlaku sesi login
JWT_EXPIRES_IN=7d

# development | production
NODE_ENV=development
